# Copy this file to .env and fill in your values.
# The Identity Pool ID will be embedded in the browser bundle — this is expected.
# Restrict the Cognito unauthenticated role to transcribe:StartMedicalStreamTranscription only.

VITE_AWS_REGION=us-east-1
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
